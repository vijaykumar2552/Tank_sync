{
  "name": "tanksync-tts-bridge",
  "version": "1.0.0",
  "private": true,
  "description": "Small, secure server-side bridge: The Things Stack webhook -> Firebase Realtime Database. Never bundled into the frontend.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "test:local": "tsx scripts/test-local.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "firebase-admin": "^12.7.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
